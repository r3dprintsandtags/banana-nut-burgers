# Admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Forms e-sign (AES-GCM key: 32 bytes as 64 hex characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORMS_ENC_KEY=

# Turnstile (form submit)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shop identity (registration numbers + PDF stamps)
SHOP_CODE=BNB
SHOP_NAME=Banana Nut Burgers Dive Shop
SHOP_TZ=America/Tegucigalpa
TRAINING_CENTER_ADDRESS=Tita's Pink Seahorse Bar, West End, Roatán, Honduras

# Secure forms link. Pages cannot bind send_email. If you add a mail worker later,
# set EMAIL on the function and FORMS_FROM_EMAIL. Until then the customer gets a copyable link.
FORMS_FROM_EMAIL=banananutburgers@gmail.com
FORMS_BASE_URL=https://banananutburgers.com

# Telnyx WhatsApp Utility template "form_link"
# Variables (body order): customer_name, form_name, shop_name, form_link
TELNYX_API_KEY=
TELNYX_WHATSAPP_FROM=
WHATSAPP_FORM_TEMPLATE=form_link
WHATSAPP_FORM_TEMPLATE_LANG=en_US
SMS_ENABLED=true
CRON_SECRET=
